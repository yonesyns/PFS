meta {
  name: Get Payments by Customer
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/payments/customer/{{testCustomerId}}
}

assert {
  res.status: eq 200
}

tests {
  test("Get payments by customer", function() {
    expect(res.getStatus()).to.equal(200);
    expect(Array.isArray(res.getBody())).to.be.true;
    
    // Check if all payments belong to the customer
    res.getBody().forEach(payment => {
      expect(payment.customerId).to.equal(parseInt(bru.getVar("testCustomerId")));
    });
  });
}