meta {
  name: Process Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": {{testCustomerId}},
    "bookingId": 1,
    "amount": 299.99,
    "method": "CREDIT_CARD",
    "description": "Vehicle rental payment"
  }
}

assert {
  res.status: eq 201
  res.body.amount: eq 299.99
  res.body.customerId: eq {{testCustomerId}}
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("testPaymentId", res.getBody().id);
  }
}

tests {
  test("Payment processed successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().amount).to.equal(299.99);
    expect(res.getBody().method).to.equal("CREDIT_CARD");
    expect(res.getBody().status).to.be.oneOf(["COMPLETED", "PROCESSING"]);
    expect(res.getBody().transactionId).to.exist;
  });
}