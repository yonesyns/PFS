meta {
  name: Performance Test - Load Testing
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vehicles/available
}

script:pre-request {
  // Set up performance monitoring
  bru.setVar("startTime", Date.now());
}

script:post-response {
  const endTime = Date.now();
  const startTime = bru.getVar("startTime");
  const responseTime = endTime - startTime;
  
  console.log(`Response time: ${responseTime}ms`);
  
  // Log performance metrics
  if (responseTime > 1000) {
    console.warn("Slow response detected!");
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 2000
}

tests {
  test("Performance - Response time under 2 seconds", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getResponseTime()).to.be.below(2000);
  });
  
  test("Performance - Response contains data", function() {
    expect(Array.isArray(res.getBody())).to.be.true;
  });
}