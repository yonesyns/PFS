meta {
  name: Complete Booking Workflow
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/customers
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Alice",
    "lastName": "Smith",
    "email": "alice.smith@example.com",
    "phone": "+1987654321",
    "address": {
      "street": "456 Oak Ave",
      "city": "Los Angeles",
      "state": "CA",
      "zipCode": "90210",
      "country": "USA"
    },
    "status": "ACTIVE",
    "type": "INDIVIDUAL"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const customerId = res.getBody().id;
    bru.setVar("integrationCustomerId", customerId);
    
    // Step 2: Create a vehicle
    const vehicleRequest = {
      method: 'POST',
      url: bru.getVar("baseUrl") + '/api/vehicles',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        "vin": "2HGBH41JXMN109187",
        "make": "Honda",
        "model": "Civic",
        "year": 2023,
        "color": "Red",
        "licensePlate": "XYZ-789",
        "type": "CAR",
        "mileage": 5000.0,
        "location": "LA Depot"
      })
    };
    
    // Step 3: Process payment
    // Step 4: Upload documents
    // This would be a complete integration test
  }
}

tests {
  test("Integration test - Customer creation", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().firstName).to.equal("Alice");
  });
}