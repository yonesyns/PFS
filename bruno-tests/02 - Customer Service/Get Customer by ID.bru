meta {
  name: Get Customer by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/customers/{{testCustomerId}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{testCustomerId}}
}

tests {
  test("Get customer by ID", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.exist;
    expect(res.getBody().firstName).to.exist;
    expect(res.getBody().email).to.exist;
  });
}