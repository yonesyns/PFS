meta {
  name: Create Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/customers
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "phone": "+1234567890",
    "address": {
      "street": "123 Main St",
      "city": "New York",
      "state": "NY",
      "zipCode": "10001",
      "country": "USA"
    },
    "status": "ACTIVE",
    "type": "INDIVIDUAL"
  }
}

assert {
  res.status: eq 201
  res.body.firstName: eq John
  res.body.email: eq john.doe@example.com
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("testCustomerId", res.getBody().id);
  }
}

tests {
  test("Customer created successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().firstName).to.equal("John");
    expect(res.getBody().lastName).to.equal("Doe");
    expect(res.getBody().email).to.equal("john.doe@example.com");
  });
}