meta {
  name: Eureka Server Health
  type: http
  seq: 1
}

get {
  url: http://localhost:8082/actuator/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

tests {
  test("Eureka Server is UP", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("UP");
  });
}
