meta {
  name: Create Vehicle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/vehicles
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "vin": "1HGBH41JXMN109186",
    "make": "Toyota",
    "model": "Camry",
    "year": 2023,
    "color": "Blue",
    "licensePlate": "ABC-123",
    "type": "CAR",
    "mileage": 15000.5,
    "location": "New York Depot"
  }
}

assert {
  res.status: eq 201
  res.body.make: eq Toyota
  res.body.model: eq Camry
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("testVehicleId", res.getBody().id);
  }
}

tests {
  test("Vehicle created successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().make).to.equal("Toyota");
    expect(res.getBody().model).to.equal("Camry");
    expect(res.getBody().vin).to.equal("1HGBH41JXMN109186");
    expect(res.getBody().status).to.equal("AVAILABLE");
  });
}